{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git push:*)",
      "Bash(git mv:*)",
      "Bash(gh:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(mkdir:*)",
      "Bash(node .claude/hooks/verify-build.js:*)",
      "Bash(npx sanoy-ai-workflow:*)",
      "PowerShell(git status *)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)",
      "PowerShell(git show *)",
      "PowerShell(git branch *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git switch *)",
      "PowerShell(git push *)",
      "PowerShell(gh *)",
      "PowerShell(.\\scripts\\azdo-create-pbi.ps1 *)",
      "PowerShell(.\\scripts\\azdo-get-workitem.ps1 *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-String *)",
      "PowerShell(Test-Path *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets.*)",
      "Read(.claude/azdo.local.json)",
      "Bash(git reset:*)",
      "PowerShell(git reset *)",
      "Bash(git checkout:*)",
      "PowerShell(git checkout *)",
      "Bash(git clean:*)",
      "PowerShell(git clean *)",
      "Bash(git rebase:*)",
      "PowerShell(git rebase *)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-build.js\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
